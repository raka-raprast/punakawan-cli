{
  "name": "pkwn",
  "version": "0.1.0",
  "description": "Reliable multi-backend coding-agent connector: routes to Claude Code, Codex CLI, and Gemini/Antigravity CLI over their own subscription logins, exposed as a persistent VPS daemon with an OpenAI-compatible API and hub-style session control.",
  "private": true,
  "type": "module",
  "bin": {
    "pkwn": "./bin/pkwn"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts daemon",
    "start": "node dist/cli.js daemon",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.5.13",
    "react-devtools-core": "^6.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
